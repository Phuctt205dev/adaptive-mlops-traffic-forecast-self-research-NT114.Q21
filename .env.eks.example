# EKS deployment template. Copy to a private secret store or CI/CD variables.
# Do not commit real values.

# Public endpoints
PUBLIC_API_BASE_URL=https://api.example.com/api/v1
GITHUB_PAGES_ORIGIN=https://<github-user>.github.io
GITHUB_PAGES_SITE=https://<github-user>.github.io/<repo-name>

# AWS
AWS_DEFAULT_REGION=ap-southeast-1
AWS_REGION=ap-southeast-1
S3_BUCKET=traffic-mlops-artifacts
DATASET_BUCKET=traffic-datasets

# Backend API
DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@<rds-endpoint>:5432/traffic_management
AUTH_SECRET_KEY=<long-random-jwt-secret>
INTERNAL_TRAINING_TOKEN=<long-random-internal-token>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_RATE_LIMIT_PER_MINUTE=20
PREDICTION_RATE_LIMIT_PER_MINUTE=120
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<change-admin-password>
DATASET_MAX_UPLOAD_BYTES=104857600
DATASET_MIN_ROWS=4380
CORS_ORIGINS=["https://<github-user>.github.io","https://<github-user>.github.io/<repo-name>"]

# Airflow
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<change-airflow-password>
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_SECRET_KEY=<long-random-airflow-secret>
AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://<db-user>:<db-password>@<rds-endpoint>:5432/airflow
TRAINING_DAG_ID=traffic_region_training

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://<db-user>:<db-password>@<rds-endpoint>:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://traffic-mlops-artifacts/mlflow
MLFLOW_HEALTH_URL=http://mlflow:5000/health

# S3-compatible configuration.
# For real AWS S3, leave endpoint URL empty or omit it in Kubernetes.
S3_ENDPOINT_URL=
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=<use-irsa-instead-when-possible>
AWS_SECRET_ACCESS_KEY=<use-irsa-instead-when-possible>
