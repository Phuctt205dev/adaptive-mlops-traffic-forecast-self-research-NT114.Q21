# Local development only. Copy to .env and replace every default password.
POSTGRES_PASSWORD=traffic_dev_password
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MLFLOW_PORT=5000

AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=local-airflow-secret-key-change-me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:30073","http://127.0.0.1:30073"]

AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_RATE_LIMIT_PER_MINUTE=20
PREDICTION_RATE_LIMIT_PER_MINUTE=120
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123456
INTERNAL_TRAINING_TOKEN=replace-with-a-long-random-internal-token
DATASET_MAX_UPLOAD_BYTES=104857600
DATASET_MIN_ROWS=4380
