# GitHub Pages frontend build template.
# In GitHub Actions, set these as repository/environment variables.

# Required: public HTTPS API exposed by k3s Node 1 through Nginx + Certbot.
VITE_API_BASE_URL=https://api.traffic-mlops.webredirect.org/api/v1

# Required for GitHub Pages project sites.
# Example: repo URL https://github.com/my-user/traffic-forecast
#          site URL https://my-user.github.io/traffic-forecast/
#          VITE_BASE_PATH=/traffic-forecast/
VITE_BASE_PATH=/adaptive-mlops-traffic-forecast-self-research-NT114.Q21/

# If using a custom domain at the root, use:
# VITE_BASE_PATH=/
