project_name = "traffic-mlops"
environment  = "dev"
aws_region   = "ap-southeast-1"

# Recommended: replace with your public IP /32 before applying.
# Example: ["203.0.113.10/32"]
admin_cidr_blocks = ["0.0.0.0/0"]

cluster_version = "1.30"

# t3.large is a practical minimum for API + Airflow + MLflow demo workloads.
node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
